# --- Core ---
MONGODB_URI=
GEMINI_API_KEY=

# --- Instagram automation (/admin/instagram) ---
# Password for the admin page and its API
ADMIN_PASSWORD=
# Meta App Secret (App settings > Basic). Verifies webhook signatures.
IG_APP_SECRET=
# Any word you choose. Type the same word in the Meta webhook dashboard.
IG_VERIFY_TOKEN=
# Optional. Defaults to https://graph.facebook.com/v23.0
# Use https://graph.instagram.com/v23.0 for an Instagram-login token.
IG_GRAPH_BASE=
# Optional. Lets a scheduler call /api/instagram-poll without the admin password.
CRON_SECRET=
